[gd_resource type="Theme" format=3 uid="uid://bp_theme"]

[resource]

; ── BPStatLabel  (small category headings) ────────────────────────────────────
Label/colors/font_color/BPStatLabel       = Color(0.75, 0.92, 1.00, 1.0)
Label/font_sizes/font_size/BPStatLabel    = 18

; ── BPStatValue  (large numbers) ──────────────────────────────────────────────
Label/colors/font_color/BPStatValue       = Color(1.00, 1.00, 1.00, 1.0)
Label/font_sizes/font_size/BPStatValue    = 38

; ── BPInfoLabel  (controls panel, piece name) ─────────────────────────────────
Label/colors/font_color/BPInfoLabel       = Color(0.75, 0.92, 1.00, 0.80)
Label/font_sizes/font_size/BPInfoLabel    = 17

; ── BPOverlay  (intro / pause / game-over text) ───────────────────────────────
Label/colors/font_color/BPOverlay         = Color(0.90, 0.97, 1.00, 1.0)
Label/font_sizes/font_size/BPOverlay      = 22

; ── BPCareerLabel  (top banner) ───────────────────────────────────────────────
Label/colors/font_color/BPCareerLabel     = Color(0.20, 0.55, 1.00, 1.0)
Label/font_sizes/font_size/BPCareerLabel  = 20
